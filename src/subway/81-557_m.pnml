engine_capacity_MU2(subway_81_557_m, PROP_subway_81_556_m_CC, subway_81_556_h, subway_81_556_1_h)
engine_power_MU2(subway_81_557_m, PROP_subway_81_556_m_PR, subway_81_556_h, subway_81_556_1_h)

RC_head_check2(subway_81_557_m, subway_81_556_h, subway_81_556_1_h)
switch (FEAT_TRAINS, SELF, subway_81_557_m_running_cost_factor,
  [ STORE_TEMP(57, 0),    // Моторы
    STORE_TEMP(9, 1),     // Бригада
    STORE_TEMP(21-1, 2),  // Износ
    STORE_TEMP(0, 3),     // Сопровождение
    STORE_TEMP(15, 4),    // ТО
    STORE_TEMP(1, 5),     // Сертификация

    STORE_TEMP(PROP_subway_81_556_m_SD, 6),                                         // Скорость
    STORE_TEMP(round(PROP_subway_81_556_m_WT), 7),                                  // Тара
    STORE_TEMP(round(PROP_subway_81_556_m_WT + PROP_subway_81_556_m_CC / 16), 8)])  // Максимальная масса
{ subway_81_557_m_check_running_cost_factor; }                                      // 100

name_in_group_subgroup(subway_81_557_m,
  string(STR_NAME_IN_GROUP, string(STR_NAME_SUBWAY_81_556_SERIES), string(STR_NAME_SUBWAY_81_557_M)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_SUBWAY_81_556_SERIES), string(STR_LONGNAME_SUBWAY_81_557_M)),
  string(STR_NAME_SUBWAY_81_556))

hint_MU_2fact_PTE(subway_81_557_m,
  calc_loading(PROP_subway_81_556_m_CC / (4 * WIDERST_D_DOOR)),
  get_CAP_in_cb(CAP_00025_INSTANT),
  STR_PURCHASE_HINT_ENGINE_TYPE_SUBWAY_CM,
