item (FEAT_TRAINS, subway_81_557_m, 1322) {
  property {
    name: string(STR_NAME_SUBWAY_81_557_M);
    vehicle_dates(2011, 2014, 35, 10, 8, PROP_subway_81_556_m_CF)
    vehicle_subway_wagon(PROP_subway_81_556_m_WT, PROP_subway_81_556_m_CC, 4 * WIDERST_D_DOOR)
    vehicle_group_mu(subway_81_556_h)
