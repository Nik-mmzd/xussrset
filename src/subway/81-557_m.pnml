  graphics {
    purchase_menu_wagon(PROP_subway_81_556_m_CF, PROP_subway_81_556_m_RC, PROP_subway_81_556_m_SD, PROP_subway_81_556_m_WT, PROP_subway_81_556_m_TE, PROP_subway_81_556_m_PR, PROP_subway_81_556_m_CC)
                additional_text: subway_81_557_m_additional_text;
               articulated_part: articulated_part_dummy3;
               can_attach_wagon: subway_81_556_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_00025_INSTANT);
                 cargo_capacity: subway_81_557_m_cargo_capacity;
                 colour_mapping: any_cc_colour;
                        default: subway_81_557_m_sprites;
                           name: subway_81_557_m_name;
                          power: subway_81_557_m_power;
                       purchase: subway_81_557_m_purchase_sprites;
            running_cost_factor: subway_81_557_m_running_cost_factor;
                          speed: return PROP_subway_81_556_m_SD;
                     start_stop: subway_81_556_start_stop;
    tractive_effort_coefficient: return get_tec_int(PROP_subway_81_556_m_TE, PROP_subway_81_556_m_WT);
  }
}

long_name_template(subway_81_557_m, STR_LONGNAME_SUBWAY_81_557_M)
allow_subway(subway_81_557_m)
