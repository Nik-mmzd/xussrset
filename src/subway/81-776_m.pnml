// 81_776

#define PROP_subway_81_775_m_CF  PROP_subway_81_775_h_CF-3
#define PROP_subway_81_775_m_RC  PROP_subway_81_775_h_RC-3
#define PROP_subway_81_775_m_SD  PROP_subway_81_775_h_SD
#define PROP_subway_81_775_m_WT  37
#define PROP_subway_81_775_m_TE  48
#define PROP_subway_81_775_m_PR  PROP_subway_81_775_h_PR
#define PROP_subway_81_775_m_CC  recalc_capacity(342, 34, 10)

// The sheet holds two car bodies side by side: 81-776 at the template origin and the
// 81-777 trailer one template width (447 px) to the right.
#define IMAGEFILE  "src/subway/81-776_m.png"
purchase_sprites_with_icon(subway_81_776_m, 18, 0, subway)
MU_car_sprites(11anim, subway_81_776_m_mu, 32, 40)
MU_car_sprites(11anim, subway_81_777_c_mu, 479, 40)
#undef IMAGEFILE

MU_power_template(subway_81_776_m, subway_81_775_h)
MU_car_dir_direction_template(subway_81_776_m)

EMU_attach_calculation_template(subway_81_776_m_next, subway_81_775_h, subway_81_776_m, subway_81_777_c)

MU_attach_wagon_icon_template(subway_81_776_m, subway_81_775_h, type_car_motor_pant)
long_vehicle_advanced(subway_81_776_m, subway_81_776_m_sprites_start_sp)

engine_capacity_MU(subway_81_776_m, PROP_subway_81_775_m_CC, subway_81_775_h)
engine_power_MU(subway_81_776_m, PROP_subway_81_775_m_PR, subway_81_775_h)

RC_head_check(subway_81_776_m, subway_81_775_h)
switch (FEAT_TRAINS, SELF, subway_81_776_m_running_cost_factor,
  [ STORE_TEMP(57, 0),    // Моторы
    STORE_TEMP(9, 1),     // Бригада
    STORE_TEMP(21-1, 2),  // Износ
    STORE_TEMP(0, 3),     // Сопровождение
    STORE_TEMP(15, 4),    // ТО
    STORE_TEMP(1, 5),     // Сертификация

    STORE_TEMP(PROP_subway_81_775_m_SD, 6),                                         // Скорость
    STORE_TEMP(round(PROP_subway_81_775_m_WT), 7),                                  // Тара
    STORE_TEMP(round(PROP_subway_81_775_m_WT + PROP_subway_81_775_m_CC / 16), 8)])  // Максимальная масса
{ subway_81_776_m_check_running_cost_factor; }                                      // 100

name_in_group(subway_81_776_m,
  string(STR_NAME_IN_GROUP, string(STR_NAME_SUBWAY_81_775_SERIES), string(STR_NAME_SUBWAY_81_776_M)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_SUBWAY_81_775_SERIES), string(STR_LONGNAME_SUBWAY_81_776_M)))

hint_MU_2fact_noto_PTE(subway_81_776_m,
  calc_loading(PROP_subway_81_775_m_CC / (4 * WIDERST_D_DOOR)),
  get_CAP_in_cb(CAP_00025_INSTANT),
  STR_PURCHASE_HINT_ENGINE_TYPE_SUBWAY_CM,
  STR_SECTIONS_SMU_2_8_MOSCOW2020,
  2020,
  fact_mytishchi(),
  fact_alexandrovskii(),
  string(STR_NAME_SUBWAY_81_775_H), PROP_subway_81_775_m_PR, PROP_subway_81_775_m_TE)

item (FEAT_TRAINS, subway_81_776_m, 1335) {
  property {
    name: string(STR_NAME_SUBWAY_81_776_M);
    vehicle_dates(2020, 2050, 35, 10, 8, PROP_subway_81_775_m_CF)
    vehicle_subway_wagon(PROP_subway_81_775_m_WT, PROP_subway_81_775_m_CC, 4 * WIDERST_D_DOOR)
    vehicle_group_mu(subway_81_775_h)
  }
  graphics {
    purchase_menu_wagon(PROP_subway_81_775_m_CF, PROP_subway_81_775_m_RC, PROP_subway_81_775_m_SD, PROP_subway_81_775_m_WT, PROP_subway_81_775_m_TE, PROP_subway_81_775_m_PR, PROP_subway_81_775_m_CC)
                additional_text: subway_81_776_m_additional_text;
               articulated_part: articulated_part_dummy3;
               can_attach_wagon: subway_81_775_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_00025_INSTANT);
                 cargo_capacity: subway_81_776_m_cargo_capacity;
                 colour_mapping: any_cc_colour;
                        default: subway_81_776_m_sprites;
                           name: subway_81_776_m_name;
                          power: subway_81_776_m_power;
                       purchase: subway_81_776_m_purchase_sprites;
            running_cost_factor: subway_81_776_m_running_cost_factor;
                          speed: return PROP_subway_81_775_m_SD;
                     start_stop: subway_81_775_start_stop;
    tractive_effort_coefficient: return get_tec_int(PROP_subway_81_775_m_TE, PROP_subway_81_775_m_WT);
  }
}

long_name_template(subway_81_776_m, STR_LONGNAME_SUBWAY_81_776_M)
allow_subway(subway_81_776_m)
