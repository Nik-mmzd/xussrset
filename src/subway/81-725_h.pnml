MU_start_stop_template_even(subway_81_725, subway_81_725_h)

// Deliberate exception to the set convention: every sheet block is a line livery, none
// of them is a plain factory paint, so the default subtype carries the Saint-Petersburg
// line 1 colours and says so instead of reading as the factory livery. Line 1 therefore
// needs no LV constant of its own. Every subtype outside the LV list must return the
// line 1 string too: the refit window collapses equally-named subtypes into one entry,
// and a stray factory-named subtype would surface as a phantom livery with no sprites.
switch (FEAT_TRAINS, SELF, subway_81_725_cargo_subtype_text,
  (cargo_subtype == LV_SUBWAY_SPB_LINE2) ||
  (cargo_subtype == LV_SUBWAY_SPB_LINE5) ||
  (cargo_subtype == LV_SUBWAY_SPB_LINE6) ||
  (cargo_subtype == LV_SUBWAY_NOVOSIBIRSK) )
{ 1: general_cargo_subtype_text0; return string(STR_REFIT_LV_SUBWAY_SPB_LINE1); }

