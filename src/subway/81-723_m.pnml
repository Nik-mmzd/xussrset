#undef IMAGEFILE
#define IMAGEFILE  "src/subway/81-723.3_m.png"
MU_car_sprites(11anim, subway_81_723_m_v3_mu, 32, 40)
#undef IMAGEFILE

MU_power_template(subway_81_723_m_v1, subway_81_722_h)
MU_power_template(subway_81_723_m_v2, subway_81_722_h)
MU_power_template(subway_81_723_m_v3, subway_81_722_h)

switch (FEAT_TRAINS, SELF, subway_81_723_m_sprites_left,
  cargo_subtype)
{
     0: subway_81_723_m_v1_sprites_left;
  0xE0: subway_81_723_m_v2_sprites_left;
  0xE1: subway_81_723_m_v3_sprites_left;
  align_11_sprites;
}
switch (FEAT_TRAINS, SELF, subway_81_723_m_sprites_right,
  cargo_subtype)
{
     0: subway_81_723_m_v1_sprites_right;
  0xE0: subway_81_723_m_v2_sprites_right;
  0xE1: subway_81_723_m_v3_sprites_right;
  align_11_sprites;
}

MU_car_dir_direction_template(subway_81_723_m)

EMU_attach_calculation_template(subway_81_723_m_next, subway_81_722_h, subway_81_723_m, subway_81_724_c)

MU_attach_wagon_icon_template(subway_81_723_m, subway_81_722_h, type_car_motor_pant)
long_vehicle_advanced(subway_81_723_m, subway_81_723_m_sprites_start_sp)

engine_capacity_MU(subway_81_723_m, PROP_subway_81_722_m_CC, subway_81_722_h)
engine_power_MU(subway_81_723_m, PROP_subway_81_722_m_PR, subway_81_722_h)
engine_refit_cost_for_livery_change(subway_81_723_m, 1)

RC_head_check(subway_81_723_m, subway_81_722_h)
switch (FEAT_TRAINS, SELF, subway_81_723_m_running_cost_factor,
  [ STORE_TEMP(57, 0),    // Моторы
    STORE_TEMP(9, 1),     // Бригада
    STORE_TEMP(21-1, 2),  // Износ
    STORE_TEMP(0, 3),     // Сопровождение
    STORE_TEMP(15, 4),    // ТО
    STORE_TEMP(1, 5),     // Сертификация

    STORE_TEMP(PROP_subway_81_722_m_SD, 6),                                         // Скорость
    STORE_TEMP(round(PROP_subway_81_722_m_WT), 7),                                  // Тара
    STORE_TEMP(round(PROP_subway_81_722_m_WT + PROP_subway_81_722_m_CC / 16), 8)])  // Максимальная масса
{ subway_81_723_m_check_running_cost_factor; }                                      // 100

name_in_group(subway_81_723_m,
  string(STR_NAME_IN_GROUP, string(STR_NAME_SUBWAY_81_722_SERIES), string(STR_NAME_SUBWAY_81_723_M)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_SUBWAY_81_722_SERIES), string(STR_LONGNAME_SUBWAY_81_723_M)))

hint_MU_PTE(subway_81_723_m,
  calc_loading(PROP_subway_81_722_m_CC / (4 * WIDERST_D_DOOR)),
  get_CAP_in_cb(CAP_00025_INSTANT),
  STR_PURCHASE_HINT_ENGINE_TYPE_SUBWAY_CM,
  STR_SECTIONS_SMU_2_8_JUBILEE,
  2014, 2021,
  fact_mytishchi(),
  string(STR_NAME_SUBWAY_81_722_H), PROP_subway_81_722_m_PR, PROP_subway_81_722_m_TE)

item (FEAT_TRAINS, subway_81_723_m, 1331) {
  property {
    name: string(STR_NAME_SUBWAY_81_723_M);
    vehicle_dates(2014, 2021, 35, 10, 8, PROP_subway_81_722_m_CF)
    vehicle_subway_wagon(PROP_subway_81_722_m_WT, PROP_subway_81_722_m_CC, 4 * WIDERST_D_DOOR)
    vehicle_group_mu(subway_81_722_h)
  }
  graphics {
    purchase_menu_wagon(PROP_subway_81_722_m_CF, PROP_subway_81_722_m_RC, PROP_subway_81_722_m_SD, PROP_subway_81_722_m_WT, PROP_subway_81_722_m_TE, PROP_subway_81_722_m_PR, PROP_subway_81_722_m_CC)
                additional_text: subway_81_723_m_additional_text;
               articulated_part: articulated_part_dummy3;
               can_attach_wagon: subway_81_722_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_00025_INSTANT);
                 cargo_capacity: subway_81_723_m_cargo_capacity;
             cargo_subtype_text: subway_81_722_cargo_subtype_text;
                 colour_mapping: any_cc_colour;
                        default: subway_81_723_m_sprites;
                           name: subway_81_723_m_name;
                          power: subway_81_723_m_power;
                       purchase: subway_81_723_m_purchase_sprites;
                     refit_cost: subway_81_723_m_refit_cost;
            running_cost_factor: subway_81_723_m_running_cost_factor;
                          speed: return PROP_subway_81_722_m_SD;
                     start_stop: subway_81_722_start_stop;
    tractive_effort_coefficient: return get_tec_int(PROP_subway_81_722_m_TE, PROP_subway_81_722_m_WT);
  }
}

long_name_template(subway_81_723_m, STR_LONGNAME_SUBWAY_81_723_M)
allow_subway(subway_81_723_m)
