#define PROP_subway_81_722_m_TE  37
#define PROP_subway_81_722_m_PR  PROP_subway_81_722_h_PR
// "Вместимость метро": 44 seats, 184 pax at the in-game 4 pax/m2 density.
#define PROP_subway_81_722_m_CC  184

// The base-livery intermediate car shares the sheet of the head series (81-722_m.png),
// the repaints have their own sheets under the 81-723 number.
#define IMAGEFILE  "src/subway/81-722_m.png"
purchase_sprites_with_icon(subway_81_723_m, 18, 0, subway)
MU_car_sprites(11anim, subway_81_723_m_v1_mu, 32, 40)
#undef IMAGEFILE
#define IMAGEFILE  "src/subway/81-723.1_m.png"
