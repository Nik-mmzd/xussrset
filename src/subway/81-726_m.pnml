{
                      0: subway_81_726_m_v1_sprites_left;
    LV_SUBWAY_SPB_LINE2: subway_81_726_m_v2_sprites_left;
    LV_SUBWAY_SPB_LINE5: subway_81_726_m_v3_sprites_left;
    LV_SUBWAY_SPB_LINE6: subway_81_726_m_v4_sprites_left;
  LV_SUBWAY_NOVOSIBIRSK: subway_81_726_m_v5_sprites_left;
  align_11_sprites;
}
switch (FEAT_TRAINS, SELF, subway_81_726_m_sprites_right,
  cargo_subtype)
{
                      0: subway_81_726_m_v1_sprites_right;
    LV_SUBWAY_SPB_LINE2: subway_81_726_m_v2_sprites_right;
    LV_SUBWAY_SPB_LINE5: subway_81_726_m_v3_sprites_right;
    LV_SUBWAY_SPB_LINE6: subway_81_726_m_v4_sprites_right;
  LV_SUBWAY_NOVOSIBIRSK: subway_81_726_m_v5_sprites_right;
