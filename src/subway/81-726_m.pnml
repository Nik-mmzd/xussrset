item (FEAT_TRAINS, subway_81_726_m, 1339) {
  property {
    name: string(STR_NAME_SUBWAY_81_726_M);
    vehicle_dates(2022, 2050, 35, 10, 8, PROP_subway_81_725_m_CF)
    vehicle_subway_wagon(PROP_subway_81_725_m_WT, PROP_subway_81_725_m_CC, 4 * WIDERST_D_DOOR)
    vehicle_group_mu(subway_81_725_h)
  }
  graphics {
    purchase_menu_wagon(PROP_subway_81_725_m_CF, PROP_subway_81_725_m_RC, PROP_subway_81_725_m_SD, PROP_subway_81_725_m_WT, PROP_subway_81_725_m_TE, PROP_subway_81_725_m_PR, PROP_subway_81_725_m_CC)
                additional_text: subway_81_726_m_additional_text;
               articulated_part: articulated_part_dummy3;
               can_attach_wagon: subway_81_725_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_00025_INSTANT);
                 cargo_capacity: subway_81_726_m_cargo_capacity;
             cargo_subtype_text: subway_81_725_cargo_subtype_text;
                 colour_mapping: any_cc_colour;
                        default: subway_81_726_m_sprites;
                           name: subway_81_726_m_name;
                          power: subway_81_726_m_power;
                       purchase: subway_81_726_m_purchase_sprites;
            running_cost_factor: subway_81_726_m_running_cost_factor;
                          speed: return PROP_subway_81_725_m_SD;
                     start_stop: subway_81_725_start_stop;
    tractive_effort_coefficient: return get_tec_int(PROP_subway_81_725_m_TE, PROP_subway_81_725_m_WT);
  }
}

long_name_template(subway_81_726_m, STR_LONGNAME_SUBWAY_81_726_M)
allow_subway(subway_81_726_m)
