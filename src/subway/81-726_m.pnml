// TODO: mass unverified, no table data — taken from 81-776 "Москва 2020"
#define PROP_subway_81_725_m_WT  37
// TE derived as the table coefficient 1.2 kN/t applied to the placeholder mass
#define PROP_subway_81_725_m_TE  44
#define PROP_subway_81_725_m_PR  PROP_subway_81_725_h_PR
// "Вместимость метро": 39 seats, 180 pax at the in-game 4 pax/m2 density.
#define PROP_subway_81_725_m_CC  180

#define IMAGEFILE  "src/subway/81-726_m.png"
purchase_sprites_with_icon(subway_81_726_m, 18, 0, subway)
