// eg2tv_1

#define PROP_eg2tv_1_m_CF  2 * 43
#define PROP_eg2tv_1_m_RC  217
#define PROP_eg2tv_1_m_SD  120
#define PROP_eg2tv_1_m_WT  54
#define PROP_eg2tv_1_m_TE  66.9
#define PROP_eg2tv_1_m_PR  1200
#define PROP_eg2tv_1_m_CC  68

#define IMAGEFILE  "src/emu/eg2tv_1_m.png"
purchase_sprites_with_icon(eg2tv_1_m, 18, 0, 3dc)
EMU_motor1_sprites(13, eg2tv_1_m_v1_mu, 32, 40)
EMU_motor1_sprites(13, eg2tv_1_m_v2_mu, 32, 308)
#undef IMAGEFILE

MU_power_dir_template2(eg2tv_1_m_v1, eg2tv_1_h, eg2tv_2_h)
MU_power_dir_template2(eg2tv_1_m_v2, eg2tv_1_h, eg2tv_2_h)

switch (FEAT_TRAINS, SELF, eg2tv_1_m_direction_left,
  cargo_subtype)
{
  0: eg2tv_1_m_v1_direction_left;
  1: eg2tv_1_m_v2_direction_left;
  align_13_sprites;
}

switch (FEAT_TRAINS, SELF, eg2tv_1_m_direction_right,
  cargo_subtype)
{
  0: eg2tv_1_m_v1_direction_right;
  1: eg2tv_1_m_v2_direction_right;
  align_13_sprites;
}

EMU_4_12_m_template(eg2tv_1)
EMU_direction_calculation_template2set(eg2tv_1_m, eg2tv_1_h, eg2tv_1_m, eg2tv_1_c, eg2tv_2_h, eg2tv_2_m, eg2tv_2_c)
EMU_4_12_free_attach_wagon_icon_template(eg2tv_1_m)
EMU_count_calculation_template2set(eg2tv_1_m_next, eg2tv_1_h, eg2tv_1_m, eg2tv_1_c, eg2tv_2_h, eg2tv_2_m, eg2tv_2_c)
MU_attach_wagon_icon_template2(eg2tv_1_m, eg2tv_1_h, eg2tv_2_h, type_car_motor_pant)
long_vehicle_advanced(eg2tv_1_m, eg2tv_1_m_sprites_start_sp)

EMU_4_12_m_create_effect_template(eg2tv_1, -1, 6)
EMU_direction_calculation_template2set(eg2tv_1_m_create_effect, eg2tv_1_h, eg2tv_1_m, eg2tv_1_c, eg2tv_2_h, eg2tv_2_m, eg2tv_2_c)
engine_effects_MU2(eg2tv_1_m, _create_effect_direction_template, eg2tv_1_h, eg2tv_2_h)
engine_power_MU2(eg2tv_1_m, PROP_eg2tv_1_m_PR, eg2tv_1_h, eg2tv_2_h)
engine_capacity_MU2(eg2tv_1_m, PROP_eg2tv_1_m_CC, eg2tv_1_h, eg2tv_2_h)

RC_head_check2(eg2tv_1_m, eg2tv_1_h, eg2tv_2_h)
switch (FEAT_TRAINS, SELF, eg2tv_1_m_running_cost_factor,
  [ STORE_TEMP(135, 0),  // Моторы
    STORE_TEMP(0, 1),    // Бригада
    STORE_TEMP(47, 2),   // Износ
    STORE_TEMP(0, 3),    // Сопровождение
    STORE_TEMP(33, 4),   // ТО
    STORE_TEMP(2, 5),    // Сертификация

    STORE_TEMP(PROP_eg2tv_1_m_SD, 6),                                   // Скорость
    STORE_TEMP(round(PROP_eg2tv_1_m_WT), 7),                            // Тара
    STORE_TEMP(round(PROP_eg2tv_1_m_WT + PROP_eg2tv_1_m_CC / 16), 8)])  // Максимальная масса
{ eg2tv_1_m_check_running_cost_factor; }                                // 217

name_in_group_subgroup(eg2tv_1_m,
  string(STR_NAME_IN_GROUP, string(STR_NAME_EG2TV_SERIES), string(STR_NAME_EG2TV_1_M)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_EG2TV_SERIES), string(STR_LONGNAME_EG2TV_1_M)),
  string(STR_NAME_EG2TV_1))

hint_MU_PTE(eg2tv_1_m,
  calc_loading(PROP_eg2tv_1_m_CC / (2 * WIDERST_D_DOOR)),
  get_CAP_in_cb(CAP_00075_ACCELERATED),
  STR_PURCHASE_HINT_ENGINE_TYPE_EMU_MP_DC,
  STR_SECTIONS_EMU_IVOLGA_4_12,
  2018, 2021,
  fact_tver(),
  string(STR_NAME_EG2TV_1), PROP_eg2tv_1_m_PR, PROP_eg2tv_1_m_TE)

item (FEAT_TRAINS, eg2tv_1_m, 1346) {
  property {
    name: string(STR_NAME_EG2TV_1_M);
    vehicle_dates(2018, 2021, 40, 10, 8, PROP_eg2tv_1_m_CF)
    vehicle_emu_wagon(dc, PROP_eg2tv_1_m_WT, PROP_eg2tv_1_m_CC, 2 * WIDERST_D_DOOR, )
    vehicle_group_mu(eg2tv_1_h)
  }
  graphics {
    purchase_menu_wagon(PROP_eg2tv_1_m_CF, PROP_eg2tv_1_m_RC, PROP_eg2tv_1_m_SD, PROP_eg2tv_1_m_WT, PROP_eg2tv_1_m_TE, PROP_eg2tv_1_m_PR, PROP_eg2tv_1_m_CC)
                additional_text: eg2tv_1_m_additional_text;
               articulated_part: articulated_part_dummy5;
               can_attach_wagon: eg2tv_1_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_00075_ACCELERATED);
                 cargo_capacity: eg2tv_1_m_cargo_capacity;
             cargo_subtype_text: eg2tv_1_cargo_subtype_text;
                 colour_mapping: any_cc_colour;
                  create_effect: eg2tv_1_m_create_effect;
                        default: eg2tv_1_m_sprites;
                           name: eg2tv_1_m_name;
                          power: eg2tv_1_m_power;
                       purchase: eg2tv_1_m_purchase_sprites;
            running_cost_factor: eg2tv_1_m_running_cost_factor;
                          speed: return PROP_eg2tv_1_m_SD;
                     start_stop: return string(STR_START_STOP_HEAD_REQUIRED);
    tractive_effort_coefficient: return get_tec_int(PROP_eg2tv_1_m_TE, PROP_eg2tv_1_m_WT);
  }
}

long_name_template(eg2tv_1_m, STR_LONGNAME_EG2TV_1_M)
allow_dcemu(eg2tv_1_m)
