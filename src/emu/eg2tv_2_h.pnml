item (FEAT_TRAINS, eg2tv_2_h, 1348) {
  property {
    name: string(STR_NAME_EG2TV_2_H);
    vehicle_dates(2019, 2050, 40, 10, 8, PROP_eg2tv_2_h_CF)
    vehicle_emu_c(dc, PROP_eg2tv_2_h_WT, PROP_eg2tv_2_h_CC, 2 * WIDERST_D_DOOR, )
    vehicle_group(group_eg2tv)
  }
  graphics {
    purchase_menu(PROP_eg2tv_2_h_CF, PROP_eg2tv_2_h_RC, PROP_eg2tv_2_h_SD, PROP_eg2tv_2_h_WT, PROP_eg2tv_2_h_TE, PROP_eg2tv_2_h_PR, PROP_eg2tv_2_h_CC)
        additional_text: eg2tv_2_h_additional_text;
       articulated_part: articulated_part_dummy5;
       can_attach_wagon: eg2tv_2_can_attach_wagon;
       cargo_age_period: return get_CAP_in_cb(CAP_00075_ACCELERATED);
         cargo_capacity: eg2tv_2_h_cargo_capacity;
     cargo_subtype_text: eg2tv_2_cargo_subtype_text;
         colour_mapping: any_cc_colour;
                default: eg2tv_2_h_sprites;
                   name: eg2tv_2_h_name;
                  power: return 0;
               purchase: eg2tv_2_h_purchase_sprites;
    running_cost_factor: eg2tv_2_h_running_cost_factor;
                  speed: return PROP_eg2tv_2_h_SD;
             start_stop: eg2tv_2_h_start_stop;
  }
}

