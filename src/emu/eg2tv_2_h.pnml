switch (FEAT_TRAINS, PARENT, eg2tv_2_can_attach_wagon,
  count_veh_id(eg2tv_2_h) + count_veh_id(eg2tv_1_h))
{
  0: return string(STR_CAN_ATTACH_HEAD_ONLY);
  1: eg2tv_2_can_attach_wagon1;
  2: eg2tv_2_can_attach_wagon_head;
  3: eg2tv_2_can_attach_wagon1;
  return string(STR_CAN_ATTACH_NO_AFTER_REAR_HEAD);
}

switch (FEAT_TRAINS, PARENT, eg2tv_2_h_start_stop,
  count_veh_id(eg2tv_2_h) + count_veh_id(eg2tv_1_h))
{
  2: return CB_RESULT_NO_TEXT;
  4: return CB_RESULT_NO_TEXT;
  return string(STR_START_STOP_NUMBER_OF_HEAD_CAR_MUST_BE_EVEN);
}

