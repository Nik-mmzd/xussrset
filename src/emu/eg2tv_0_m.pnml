{ 0x1000: type_car_motor_pant_add_mandatory;      /* Г-(М)         */
  0x2001: type_car_motor_pant_add_mandatory;      /* Г-М-(М)       */
  0x3003: type_car_motor_pant_car_add_mandatory;  /* Г-М-М-(М/П)   */
  0x4006: type_head_add_mandatory;                /* Г-М-М-П-(Г)   */
  0x4007: type_head_add_mandatory;                /* Г-М-М-М-(Г)   */
  dummy_sprites_big; }
EMU_attach_calculation_template(eg2tv_0_m_next, eg2tv_0_h, eg2tv_0_m, eg2tv_0_c)
MU_attach_wagon_icon_template(eg2tv_0_m, eg2tv_0_h, type_car_motor_pant)
long_vehicle_advanced(eg2tv_0_m, eg2tv_0_m_sprites_start_sp)

EMU_4_12_m_create_effect_template(eg2tv_0, -1, 6)
EMU_direction_calculation_template(eg2tv_0_m_create_effect, eg2tv_0_h, eg2tv_0_m, eg2tv_0_c)
engine_effects_MU(eg2tv_0_m, _create_effect_direction_template, eg2tv_0_h)
engine_power_MU(eg2tv_0_m, PROP_eg2tv_0_m_PR, eg2tv_0_h)
engine_capacity_MU(eg2tv_0_m, PROP_eg2tv_0_m_CC, eg2tv_0_h)

RC_head_check(eg2tv_0_m, eg2tv_0_h)
switch (FEAT_TRAINS, SELF, eg2tv_0_m_running_cost_factor,
  [ STORE_TEMP(164, 0),  // Моторы
    STORE_TEMP(0, 1),    // Бригада
    STORE_TEMP(58, 2),   // Износ
    STORE_TEMP(0, 3),    // Сопровождение
    STORE_TEMP(40, 4),   // ТО
    STORE_TEMP(3, 5),    // Сертификация

    STORE_TEMP(PROP_eg2tv_0_m_SD, 6),                                   // Скорость
    STORE_TEMP(round(PROP_eg2tv_0_m_WT), 7),                            // Тара
    STORE_TEMP(round(PROP_eg2tv_0_m_WT + PROP_eg2tv_0_m_CC / 16), 8)])  // Максимальная масса
{ eg2tv_0_m_check_running_cost_factor; }                                // 265

name_in_group_subgroup(eg2tv_0_m,
  string(STR_NAME_IN_GROUP, string(STR_NAME_EG2TV_SERIES), string(STR_NAME_EG2TV_0_M)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_EG2TV_SERIES), string(STR_LONGNAME_EG2TV_0_M)),
  string(STR_NAME_EG2TV_0))

hint_MU_PTE(eg2tv_0_m,
  calc_loading(PROP_eg2tv_0_m_CC / (2 * WIDERST_D_DOOR)),
  get_CAP_in_cb(CAP_00075_ACCELERATED),
  STR_PURCHASE_HINT_ENGINE_TYPE_EMU_MP_DC,
  STR_SECTIONS_EMU_IVOLGA_5,
  2014, 2015,
  fact_tver(),
  string(STR_NAME_EG2TV_0), PROP_eg2tv_0_m_PR, PROP_eg2tv_0_m_TE)

item (FEAT_TRAINS, eg2tv_0_m, 1343) {
  property {
    name: string(STR_NAME_EG2TV_0_M);
    vehicle_dates(2014, 2015, 40, 10, 8, PROP_eg2tv_0_m_CF)
    vehicle_emu_wagon(dc, PROP_eg2tv_0_m_WT, PROP_eg2tv_0_m_CC, 2 * WIDERST_D_DOOR, )
    vehicle_group_mu(eg2tv_0_h)
  }
  graphics {
    purchase_menu_wagon(PROP_eg2tv_0_m_CF, PROP_eg2tv_0_m_RC, PROP_eg2tv_0_m_SD, PROP_eg2tv_0_m_WT, PROP_eg2tv_0_m_TE, PROP_eg2tv_0_m_PR, PROP_eg2tv_0_m_CC)
                additional_text: eg2tv_0_m_additional_text;
               articulated_part: articulated_part_dummy5;
               can_attach_wagon: eg2tv_0_can_attach_wagon;
               cargo_age_period: return get_CAP_in_cb(CAP_00075_ACCELERATED);
                 cargo_capacity: eg2tv_0_m_cargo_capacity;
             cargo_subtype_text: eg2tv_0_cargo_subtype_text;
                 colour_mapping: any_cc_colour;
                  create_effect: eg2tv_0_m_create_effect;
                        default: eg2tv_0_m_sprites;
                           name: eg2tv_0_m_name;
                          power: eg2tv_0_m_power;
                       purchase: eg2tv_0_m_purchase_sprites;
            running_cost_factor: eg2tv_0_m_running_cost_factor;
                          speed: return PROP_eg2tv_0_m_SD;
                     start_stop: return string(STR_START_STOP_HEAD_REQUIRED);
    tractive_effort_coefficient: return get_tec_int(PROP_eg2tv_0_m_TE, PROP_eg2tv_0_m_WT);
  }
}

long_name_template(eg2tv_0_m, STR_LONGNAME_EG2TV_0_M)
allow_dcemu(eg2tv_0_m)
