MU_power_dir_template(eg2tv_0_m_v1, eg2tv_0_h)
MU_power_dir_template(eg2tv_0_m_v2, eg2tv_0_h)

switch (FEAT_TRAINS, SELF, eg2tv_0_m_direction_left,
