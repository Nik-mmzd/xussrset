}

engine_direction_template3m2(eg2tv_0_h, eg2tv_0_h, eg2tv_0_m, eg2tv_0_c)
MU_attach_wagon_icon_template_only(eg2tv_0_h, eg2tv_0_h, type_head, type_car_motor_pant_add_mandatory)
long_vehicle_advanced(eg2tv_0_h, eg2tv_0_h_sprites_start_sp)

EMU_4_12_can_attach_wagon_errors_template(eg2tv_0, eg2tv_0_h, eg2tv_0_m, eg2tv_0_c)
switch (FEAT_TRAINS, PARENT, eg2tv_0_can_attach_wagon_max, LOAD_TEMP(5))
{ 0x1000: eg2tv_0_can_attach_wagon_motor;     /* Г-(М)         */
  0x2001: eg2tv_0_can_attach_wagon_motor;     /* Г-М-(М)       */
  0x3003: eg2tv_0_can_attach_wagon_not_head;  /* Г-М-М-(М/П)   */
  0x4006: eg2tv_0_can_attach_wagon_head;      /* Г-М-М-П-(Г)   */
  0x4007: eg2tv_0_can_attach_wagon_head;      /* Г-М-М-М-(Г)   */
  return string(STR_CAN_ATTACH_OTHERCAR_ONLY); }
EMU_attach_calculation_template(eg2tv_0, eg2tv_0_h, eg2tv_0_m, eg2tv_0_c)

switch (FEAT_TRAINS, SELF, eg2tv_0_can_attach_wagon1,
  vehicle_type_id)
{
  eg2tv_0_h: eg2tv_0_can_attach_wagon_template;
  eg2tv_0_m: eg2tv_0_can_attach_wagon_template;
  eg2tv_0_c: eg2tv_0_can_attach_wagon_template;
  return string(STR_CAN_ATTACH_SAME_MU_ONLY);
}

switch (FEAT_TRAINS, PARENT, eg2tv_0_can_attach_wagon,
  count_veh_id(eg2tv_0_h))
{
  0: return string(STR_CAN_ATTACH_HEAD_ONLY);
  1: eg2tv_0_can_attach_wagon1;
  2: eg2tv_0_can_attach_wagon_head;
  3: eg2tv_0_can_attach_wagon1;
  return string(STR_CAN_ATTACH_NO_AFTER_REAR_HEAD);
}

switch (FEAT_TRAINS, PARENT, eg2tv_0_h_start_stop,
  count_veh_id(eg2tv_0_h))
{
  2: return CB_RESULT_NO_TEXT;
  4: return CB_RESULT_NO_TEXT;
  return string(STR_START_STOP_NUMBER_OF_HEAD_CAR_MUST_BE_EVEN);
}

livery_template_alt0(eg2tv_0, STR_REFIT_FACTORY, STR_REFIT_LV_MOSCOW_TRANSPORT)
engine_capacity_MU(eg2tv_0_h, PROP_eg2tv_0_h_CC, eg2tv_0_h)

RC_head_check(eg2tv_0_h, eg2tv_0_h)
switch (FEAT_TRAINS, SELF, eg2tv_0_h_running_cost_factor,
  [ STORE_TEMP(145, 0),  // Моторы
    STORE_TEMP(20, 1),   // Бригада
    STORE_TEMP(51, 2),   // Износ
    STORE_TEMP(0, 3),    // Сопровождение
    STORE_TEMP(35, 4),   // ТО
    STORE_TEMP(2, 5),    // Сертификация

    STORE_TEMP(PROP_eg2tv_0_h_SD, 6),                                   // Скорость
    STORE_TEMP(round(PROP_eg2tv_0_h_WT), 7),                            // Тара
    STORE_TEMP(round(PROP_eg2tv_0_h_WT + PROP_eg2tv_0_h_CC / 16), 8)])  // Максимальная масса
{ eg2tv_0_h_check_running_cost_factor; }                                // 253

name_in_group_subgroup(eg2tv_0_h,
  string(STR_NAME_IN_GROUP, string(STR_NAME_EG2TV_SERIES), string(STR_NAME_EG2TV_0_H)),
  string(STR_NAME_IN_GROUP, string(STR_NAME_EG2TV_SERIES), string(STR_LONGNAME_EG2TV_0_H)),
  string(STR_NAME_EG2TV_0))

hint_MU(eg2tv_0_h,
  calc_loading(PROP_eg2tv_0_h_CC / (2 * WIDERST_D_DOOR)),
  get_CAP_in_cb(CAP_00075_ACCELERATED),
  STR_PURCHASE_HINT_ENGINE_TYPE_EMU_H_DC,
  STR_SECTIONS_EMU_IVOLGA_5,
  2014, 2015,
  fact_tver())
map_sprites(eg2tv_0_additional_text, eg2tv_0_h_additional_text)

item (FEAT_TRAINS, eg2tv_0_h, 1342) {
  property {
    name: string(STR_NAME_EG2TV_0_H);
    vehicle_dates(2014, 2015, 40, 10, 8, PROP_eg2tv_0_h_CF)
    vehicle_emu_c(dc, PROP_eg2tv_0_h_WT, PROP_eg2tv_0_h_CC, 2 * WIDERST_D_DOOR, )
    vehicle_group(group_eg2tv)
  }
  graphics {
    purchase_menu(PROP_eg2tv_0_h_CF, PROP_eg2tv_0_h_RC, PROP_eg2tv_0_h_SD, PROP_eg2tv_0_h_WT, PROP_eg2tv_0_h_TE, PROP_eg2tv_0_h_PR, PROP_eg2tv_0_h_CC)
        additional_text: eg2tv_0_h_additional_text;
       articulated_part: articulated_part_dummy5;
       can_attach_wagon: eg2tv_0_can_attach_wagon;
       cargo_age_period: return get_CAP_in_cb(CAP_00075_ACCELERATED);
         cargo_capacity: eg2tv_0_h_cargo_capacity;
     cargo_subtype_text: eg2tv_0_cargo_subtype_text;
         colour_mapping: any_cc_colour;
                default: eg2tv_0_h_sprites;
                   name: eg2tv_0_h_name;
                  power: return 0;
               purchase: eg2tv_0_h_purchase_sprites;
    running_cost_factor: eg2tv_0_h_running_cost_factor;
                  speed: return PROP_eg2tv_0_h_SD;
             start_stop: eg2tv_0_h_start_stop;
  }
}

