map_sprites(eg2tv_0_purchase_sprites, eg2tv_0_h_purchase_sprites)

MU_power_template(eg2tv_0_h_v1, eg2tv_0_h)
MU_power_template(eg2tv_0_h_v2, eg2tv_0_h)

switch (FEAT_TRAINS, SELF, eg2tv_0_h_sprites_left,
  cargo_subtype)
{
  0: eg2tv_0_h_v1_sprites_left;
  1: eg2tv_0_h_v2_sprites_left;
  align_13_sprites;
}

switch (FEAT_TRAINS, SELF, eg2tv_0_h_sprites_right,
  cargo_subtype)
{
  0: eg2tv_0_h_v1_sprites_right;
  1: eg2tv_0_h_v2_sprites_right;
